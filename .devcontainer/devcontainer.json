{
  "name": "Money-lab",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "postCreateCommand": "pip install --user uv && uv sync && make web && uv run moneylab demo",
  "postAttachCommand": {
    "dashboard": "uv run moneylab serve --host 0.0.0.0"
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Money-lab dashboard",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["docs/walkthrough.md"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
