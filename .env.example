# Copy to .env and fill in. Every value has a safe default except the provider key.

# Where data snapshots (Parquet), the SQLite database and run outputs live.
MONEYLAB_HOME=./var

# Market-data provider. "file" works offline; "equibles" is the live provider used by
# `moneylab fetch` (see docs/providers.md).
MONEYLAB_PROVIDER=file
# Equibles credential (no MONEYLAB_ prefix). In cloud sessions set it as an environment
# secret instead of here. Get a key at https://equibles.com
# Never commit a real key; .env is git-ignored.
EQUIBLES_API_KEY=

# Folder the file-import adapter reads from (see docs/file-import-format.md).
MONEYLAB_IMPORT_DIR=./fixtures/data

# Worker processes for concurrent variant runs (0 = number of CPU cores).
MONEYLAB_WORKERS=0

# Execution defaults (spec section 3). Runs persist the resolved values they used.
MONEYLAB_STARTING_CASH=100000
MONEYLAB_TARGET_ALLOCATION=0.10
MONEYLAB_MAX_POSITIONS=10
MONEYLAB_COST_BPS_PER_SIDE=5




